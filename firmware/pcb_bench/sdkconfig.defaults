# Seeed XIAO ESP32-S3 Sense: ESP32-S3R8, 8 MB octal PSRAM, 8 MB flash.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM holds the 640x640 board pair (2 x 400 KB) and the model parameter copy.
# The XIAO's module uses octal (OPI) PSRAM -- verify against your board revision
# if heap_caps_malloc(MALLOC_CAP_SPIRAM) returns null at startup.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Benchmark numbers are reported at the stock 240 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 1 kHz tick keeps scheduler jitter small next to per-tile latencies.
CONFIG_FREERTOS_HZ=1000

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
