# Raw data and built tile datasets are never committed.
data/raw/
data/DeepPCB
data/DeepPCB/
data/tiles/
*.npz
*.npy
*.pt
*.pth
*.tflite
*.espdl

# Figures regenerated by scripts/notebooks
eval/figures/*.png
eval/figures/*.pdf

# Python
__pycache__/
.pytest_cache/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ESP-IDF
firmware/**/build/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/managed_components/

# OS
.DS_Store

# Training runs. The plan requires saving the config, seeds, metrics and the
# exact model file behind every result, so those are committed: a student
# checkpoint is only ~274 KB. Excluded are last.pt (redundant with best.pt)
# and teacher weights, which are ~45 MB each.
runs/**/last.pt
runs/**/state.pt
runs/teacher*/*.pt
!runs/**/best.pt
runs/teacher*/best.pt
