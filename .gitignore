# Raw data and built tile datasets are never committed.
data/raw/
data/DeepPCB
data/DeepPCB/
data/tiles/
*.npz
*.npy
*.pt
*.pth
*.tflite
*.espdl

# Figures regenerated by scripts/notebooks
eval/figures/*.png
eval/figures/*.pdf

# Python
__pycache__/
.pytest_cache/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ESP-IDF
firmware/**/build/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/managed_components/

# OS
.DS_Store

# Training runs: checkpoints are large and regenerable from the saved config.
runs/**/*.pt
